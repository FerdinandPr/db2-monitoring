# Optional - ohne .env gelten die Standardwerte aus compose.yaml.
# Kopieren nach .env und anpassen:  cp .env.example .env

# --- Db2 (Container "sc-db2")
DB2_PASSWORD=Db2Sidecar-Passw0rd
DB2_DBNAME=TESTDB
DB2_PORT=50000
# DB2_IMAGE=icr.io/db2_community/db2:latest

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# --- Prometheus / Loki / Exporter
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
LOKI_PORT=3100
LOKI_RETENTION=30d
EXPORTER_PORT=9953

LOG_LEVEL=INFO
TZ=Europe/Berlin
