# Kopieren nach .env und anpassen:  cp .env.example .env

# --- Externe Db2-Datenbank (config/exporter/targets.yaml)
DB2_NAME=PRODDB
DB2_HOST=db2host.example.com
DB2_PORT=50000
DB2_DATABASE=PRODDB
DB2_USER=db2mon
DB2_PASSWORD=change-me
DB2_ENV=prod

# --- Test-Datenbank (nur mit compose.testdb.yaml)
DB2_TEST_PASSWORD=Db2Test-Passw0rd
DB2_TEST_DBNAME=TESTDB
DB2_TEST_PORT=50000
# DB2_TEST_IMAGE=icr.io/db2_community/db2:latest

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
# GRAFANA_VERSION=12.1.0

# --- Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
# PROMETHEUS_VERSION=v3.5.0

# --- Loki (db2diag-Eintraege)
LOKI_PORT=3100
LOKI_RETENTION=30d
# LOKI_VERSION=3.5.0

# --- Exporter
EXPORTER_PORT=9953
LOG_LEVEL=INFO
TZ=Europe/Berlin
