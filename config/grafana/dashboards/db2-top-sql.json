{
  "uid": "db2-top-sql",
  "title": "Db2 Top SQL",
  "tags": [
    "db2"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "db",
        "label": "Datenbank",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(db2_up, db)",
          "refId": "db"
        },
        "definition": "label_values(db2_up, db)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "member",
        "label": "Member",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(db2_database_status{db=~\"$db\"}, member)",
          "refId": "member"
        },
        "definition": "label_values(db2_database_status{db=~\"$db\"}, member)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 3,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Db2 Übersicht",
      "type": "link",
      "url": "/d/db2-overview/db2-ubersicht?${__url_time_range}&${db:queryparam}",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Teuerste Statements im Package Cache",
      "description": "Top 20 nach TOTAL_ACT_TIME aus MON_GET_PKG_CACHE_STMT, kumuliert seit Aufnahme in den Package Cache. Typ D = dynamisch, S = statisch. Vollstaendigen Text per EXECUTABLE_ID (stmt_id) in Db2 abfragen.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db2_stmt_executions{db=~\"$db\", member=~\"$member\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db2_stmt_activity_time_ms{db=~\"$db\", member=~\"$member\"}",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db2_stmt_activity_time_ms{db=~\"$db\", member=~\"$member\"} / clamp_min(db2_stmt_executions{db=~\"$db\", member=~\"$member\"}, 1)",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db2_stmt_cpu_time_us{db=~\"$db\", member=~\"$member\"} / 1000",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db2_stmt_wait_time_ms{db=~\"$db\", member=~\"$member\"}",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db2_stmt_rows_read{db=~\"$db\", member=~\"$member\"}",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db2_stmt_rows_returned{db=~\"$db\", member=~\"$member\"}",
          "legendFormat": "",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "db2_stmt_lock_wait_time_ms{db=~\"$db\", member=~\"$member\"}",
          "legendFormat": "",
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
