# Konfiguration des db2diag-Shippers -> /etc/db2diag-shipper.env
LOKI_URL=http://monitoring-host.example.com:3100
DB2DIAG_CMD=db2diag -f -json
# HOST_LABEL=db2prod01
EXTRA_LABELS=env=prod
# LOKI_TENANT=
# LOKI_USERNAME=
# LOKI_PASSWORD=
# LOKI_CA_FILE=/etc/pki/tls/certs/ca-bundle.crt
LOG_LEVEL=INFO
