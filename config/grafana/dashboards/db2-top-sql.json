    {
      "id": 2,
      "type": "timeseries",
      "title": "Ausfuehrungszeit je Sekunde (Top 10)",
      "description": "Zuwachs der kumulierten Ausfuehrungszeit. Zeigt, welche Statements gerade Last erzeugen.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
